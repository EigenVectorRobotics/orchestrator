<root BTCPP_format="4">
  <!-- Repeatability test at the freight elevator call panel, floor 2: five cycles of walk in, EKF hold, press the down
       button, press the up button. Each press is judged by the agent (press_judge) and never retried, so every cycle
       gives one press per button. The stance checks are recorded but do not stop a press. Places and map:
       ~/maps/two_floor_clean_cabin2.places.yaml and two_floor_clean_cabin2.pcd. Run with start_cycle.sh
       (docs/operations.md, "Repeatability test at the call panel") -->
  <BehaviorTree ID="freight_call_panel_press_repeat">
    <Repeat num_cycles="5">
      <Sequence>
        <Fallback>                    <!-- a transition to the current mode fails -->
          <in_high_level/>
          <set_mode mode="high_level"/>
        </Fallback>
        <clear_stop/>
        <set_autonomy enabled="true"/>
        <navigate_to goal="{freight_elevator_call_panel_preapproach}"/>
        <Sleep msec="3000"/>
        <navigate_to goal="{freight_elevator_call_panel}"/>
        <set_autonomy enabled="false"/>
        <SubTree ID="ekf_hold"/>
        <no_stale_publishers/>
        <SetBlackboard value="down button" output_key="button"/>
        <SubTree ID="press_once"/>
        <SetBlackboard value="up button" output_key="button"/>
        <SubTree ID="press_once"/>
        <set_mode mode="idle"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <!-- one press of {button} with the right arm, judged, then the arms released; it succeeds whatever the judge says -->
  <BehaviorTree ID="press_once">
    <Sequence>
      <ForceSuccess>
        <Sequence>
          <ForceSuccess>              <!-- recorded for the run records only -->
            <Sequence>
              <button_in_view query="{button}"/>
            </Sequence>
          </ForceSuccess>
          <set_press_offset x="0.0" y="0.0" z="0.0"/>
          <SubTree ID="prepare_arm"/>
          <reset_filters/>
          <press_button target_description="{button}" left_arm="false"/>
          <press_judge target_description="{button}"/>
        </Sequence>
      </ForceSuccess>
      <release_arms/>
    </Sequence>
  </BehaviorTree>

  <!-- start_cycle.sh resets the EKF when the trace shows this say, so the text must stay as it is -->
  <BehaviorTree ID="ekf_hold">
    <Sequence>
      <say text="Holding still to reset my balance estimate."/>
      <Sleep msec="10000"/>
    </Sequence>
  </BehaviorTree>

  <!-- Arm commands stay blocked after release_arms until the next mode change, and a transition to the current mode
       fails: so go to Idle first when in HighLevel, then HighLevel, then the VisualServo gains -->
  <BehaviorTree ID="prepare_arm">
    <Sequence>
      <Fallback>
        <Inverter>
          <in_high_level/>
        </Inverter>
        <set_mode mode="idle"/>
      </Fallback>
      <set_mode mode="high_level"/>
      <set_profile profile="visual_servo"/>
    </Sequence>
  </BehaviorTree>
</root>
