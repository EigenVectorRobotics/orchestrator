<root BTCPP_format="4">
  <!-- call_elevator_agentic for the robot, down button: the freight elevator call panel from the team's map places file
       (~/maps/two_floor_clean_cabin2.places.yaml, "freight elevator call panel" -> {freight_elevator_call_panel}).
       Run the executor with places_file:= that file. Online only: the agent is a session, and the VLM is on the Thor. -->
  <BehaviorTree ID="freight_call_elevator_down_agentic">
    <Sequence>
      <!-- as the field test (nav_outside.sh): HighLevel, /stop 0 and autonomy on; the preapproach about 1.1 m
           before the panel, a 3 s hold, then the panel; autonomy off on arrival. The press runs in HighLevel -->
      <Fallback>                    <!-- a transition to the current mode fails -->
        <in_high_level/>
        <set_mode mode="high_level"/>
      </Fallback>
      <clear_stop/>
      <set_autonomy enabled="true"/>
      <navigate_to goal="{freight_elevator_call_panel_preapproach}"/>
      <Sleep msec="3000"/>
      <navigate_to goal="{freight_elevator_call_panel}"/>
      <set_autonomy enabled="false"/>
      <Sleep msec="1000"/>
      <Fallback>
        <SubTree ID="press_down"/>
        <RetryUntilSuccessful num_attempts="3">
          <SubTree ID="recover_press"/>
        </RetryUntilSuccessful>
        <ForceFailure>
          <release_arms/>
        </ForceFailure>
        <say text="Please press the down button for me."/>
      </Fallback>
      <release_arms/>
      <set_mode mode="idle"/>
      <Fallback>
        <RetryUntilSuccessful num_attempts="60">
          <Delay delay_msec="1000">
            <door_open/>
          </Delay>
        </RetryUntilSuccessful>
        <ForceFailure>
          <say text="The elevator door did not open."/>
        </ForceFailure>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Arm commands stay blocked after release_arms until the next mode change, and a transition to the current mode
       fails: so go to Idle first when in HighLevel, then HighLevel, then the VisualServo gains -->
  <BehaviorTree ID="prepare_arm">
    <Sequence>
      <Fallback>
        <Inverter>
          <in_high_level/>
        </Inverter>
        <set_mode mode="idle"/>
      </Fallback>
      <set_mode mode="high_level"/>
      <set_profile profile="visual_servo"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="press_down">
    <Sequence>
      <!-- press_judge: a press counts only when the call button lights -->
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <set_press_offset x="0.0" y="0.0" z="0.0"/>   <!-- press_button refuses to run before any set_press_offset -->
      <press_button target_description="down button"/>
      <press_reached/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="recover_press">
    <Sequence>
      <manipulation_recovery phase="diagnose" target_description="down button" base_goal="{freight_elevator_call_panel}"
                             decision="{decision}" goal="{recovery_goal}" left_arm="{recovery_left_arm}"/>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="reposition"/>
        </Inverter>
        <Sequence>
          <release_arms/>
          <set_autonomy enabled="true"/>
          <navigate_to goal="{recovery_goal}"/>
          <set_autonomy enabled="false"/>
          <Sleep msec="1000"/>
          <button_in_view query="down button"/>
        </Sequence>
      </Fallback>
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="down button" left_arm="{recovery_left_arm}"/>
      <press_reached/>
    </Sequence>
  </BehaviorTree>
</root>
