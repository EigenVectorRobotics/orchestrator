<root BTCPP_format="4">
  <!-- Inside the cabin, too far from the floor panel for a reposition (closer than the 0.15 m arrival tolerance): back
       up 0.35 m, walk to the inside place again, hold for the EKF reset, press floor 1, press_judge, recovery. -->
  <BehaviorTree ID="freight_elevator_floor1_walk_in_again_agentic">
    <Sequence>
      <say text="Backing up to walk to the panel again."/>
      <Fallback>
        <in_high_level/>
        <set_mode mode="high_level"/>
      </Fallback>
      <clear_stop/>
      <set_autonomy enabled="true"/>
      <navigate_to goal="3.721 -0.459 -0.435 2.6704"/>   <!-- 0.35 m behind the inside place (3.410, -0.299), same storey -->
      <Sleep msec="2000"/>
      <SubTree ID="walk_in"/>
      <set_autonomy enabled="false"/>
      <SubTree ID="ekf_hold"/>
      <Fallback>
        <SubTree ID="press_floor1"/>
        <RetryUntilSuccessful num_attempts="3">
          <SubTree ID="recover_floor1"/>
        </RetryUntilSuccessful>
        <ForceFailure>
          <release_arms/>
        </ForceFailure>
        <say text="Please press floor one for me."/>
      </Fallback>
      <release_arms/>
      <set_mode mode="idle"/>
      <say text="Floor one is pressed."/>
    </Sequence>
  </BehaviorTree>

  <!-- a walk that finds no free path (latched terrain points): clear the terrain map and walk again -->
  <BehaviorTree ID="walk_in">
    <RetryUntilSuccessful num_attempts="3">
      <Fallback>
        <navigate_to goal="{freight_inside_button_panel_floor_2}"/>
        <ForceFailure>
          <Sequence>
            <say text="My path looks blocked. Clearing my map and trying again."/>
            <clear_terrain_map/>
            <Sleep msec="2000"/>
          </Sequence>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- reset_ekf ends once body_ekf has recalibrated on 2 s of stillness, so the robot holds still here -->
  <BehaviorTree ID="ekf_hold">
    <Sequence>
      <say text="Holding still to reset my balance estimate."/>
      <reset_ekf/>
    </Sequence>
  </BehaviorTree>

  <!-- Arm commands stay blocked after release_arms until the next mode change, and a transition to the current mode
       fails: so go to Idle first when in HighLevel, then HighLevel, then the VisualServo gains -->
  <BehaviorTree ID="prepare_arm">
    <Sequence>
      <Fallback>
        <Inverter>
          <in_high_level/>
        </Inverter>
        <set_mode mode="idle"/>
      </Fallback>
      <set_mode mode="high_level"/>
      <set_profile profile="visual_servo"/>
    </Sequence>
  </BehaviorTree>



  <!-- inside: the right arm; the left failed IK for floor buttons -->
  <BehaviorTree ID="press_floor1">
    <Sequence>
      <set_press_offset x="0.005" y="0.0075" z="0.0034"/>   <!-- inside panel, right arm -->
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="floor 1" left_arm="false"/>
      <press_judge target_description="floor 1"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="recover_floor1">
    <Sequence>
      <manipulation_recovery phase="diagnose" target_description="floor 1" base_goal="{freight_inside_button_panel_floor_2}"
                             decision="{decision}" goal="{recovery_goal}" left_arm="{recovery_left_arm}"
                             offset_x="{offset_x}" offset_y="{offset_y}" offset_z="{offset_z}"/>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="offset_retry"/>
        </Inverter>
        <set_press_offset x="{offset_x}" y="{offset_y}" z="{offset_z}"/>
      </Fallback>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="reposition"/>
        </Inverter>
        <Sequence>
          <release_arms/>
          <set_autonomy enabled="true"/>
          <navigate_to goal="{recovery_goal}"/>
          <set_autonomy enabled="false"/>
          <SubTree ID="ekf_hold"/>
          <button_in_view query="floor 1"/>
        </Sequence>
      </Fallback>
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="floor 1" left_arm="{recovery_left_arm}"/>
      <press_judge target_description="floor 1"/>
    </Sequence>
  </BehaviorTree>
</root>
