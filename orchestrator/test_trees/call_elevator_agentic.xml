<root BTCPP_format="4">
  <!-- Walk to the call panel and press up. A press that fails goes to the manipulation_recovery agent, which finds out why
       and decides: reposition (walk to a new stance, check the button is in view, press), switch_arm or retry (press
       again), ask_help (no more agent rounds), or abort (the whole tree fails at once with the agent's reason).
       At most three rounds; then a person is asked. Online only: the agent needs the cloud. -->
  <BehaviorTree ID="call_elevator_agentic">
    <Sequence>
      <navigate_to goal="{call_panel}"/>
      <Fallback>
        <SubTree ID="press_up"/>
        <RetryUntilSuccessful num_attempts="3">
          <SubTree ID="recover_press"/>
        </RetryUntilSuccessful>
        <say text="Please press the up button for me."/>
      </Fallback>
      <Fallback>
        <RetryUntilSuccessful num_attempts="60">
          <Delay delay_msec="1000">
            <door_open/>
          </Delay>
        </RetryUntilSuccessful>
        <ForceFailure>
          <say text="The elevator door did not open."/>
        </ForceFailure>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="press_up">
    <Sequence>
      <set_press_offset x="0.0" y="0.0" z="0.0"/>   <!-- press_button refuses to run before any set_press_offset -->
      <press_button target_description="up button"/>
      <button_lit target_description="up button"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="recover_press">
    <Sequence>
      <manipulation_recovery phase="diagnose" target_description="up button" base_goal="{call_panel}"
                             decision="{decision}" goal="{recovery_goal}" left_arm="{recovery_left_arm}"/>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="reposition"/>
        </Inverter>
        <Sequence>
          <navigate_to goal="{recovery_goal}"/>
          <button_in_view query="up button"/>
        </Sequence>
      </Fallback>
      <press_button target_description="up button" left_arm="{recovery_left_arm}"/>
      <button_lit target_description="up button"/>
    </Sequence>
  </BehaviorTree>
</root>
