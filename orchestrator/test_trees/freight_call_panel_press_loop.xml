<root BTCPP_format="4">
  <!-- Floor 2 call panel, until cancelled: walk to the preapproach, then the panel, hold still for the EKF reset, press
       the up button, then the down button, each once with the right arm, judged and never retried, then walk back to the
       preapproach and repeat. Run with send_tree; stop with /orchestrator/cancel -->
  <BehaviorTree ID="freight_call_panel_press_loop">
    <Repeat num_cycles="-1">
      <Sequence>
        <Fallback>                    <!-- a transition to the current mode fails -->
          <in_high_level/>
          <set_mode mode="high_level"/>
        </Fallback>
        <clear_stop/>
        <set_autonomy enabled="true"/>
        <navigate_to goal="{freight_call_panel_preapproach_floor_2}"/>
        <Sleep msec="3000"/>
        <navigate_to goal="{freight_call_panel_floor_2}"/>
        <set_autonomy enabled="false"/>
        <Sleep msec="2500"/>            <!-- the G1 settles up to 2.5 s after it stops -->
        <SubTree ID="ekf_hold"/>
        <SetBlackboard value="up button" output_key="button"/>
        <SubTree ID="press_once"/>
        <SetBlackboard value="down button" output_key="button"/>
        <SubTree ID="press_once"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <!-- one press of {button} with the right arm, judged, then the arms released; it succeeds whatever the judge says -->
  <BehaviorTree ID="press_once">
    <Sequence>
      <ForceSuccess>
        <Sequence>
          <ForceSuccess>              <!-- recorded for the run records only -->
            <Sequence>
              <button_in_view query="{button}"/>
            </Sequence>
          </ForceSuccess>
          <set_press_offset x="0.0" y="0.0" z="0.0"/>
          <SubTree ID="prepare_arm"/>
          <reset_filters/>
          <press_button target_description="{button}" left_arm="false"/>
          <press_judge target_description="{button}"/>
        </Sequence>
      </ForceSuccess>
      <release_arms/>
    </Sequence>
  </BehaviorTree>

  <!-- reset_ekf ends once body_ekf has recalibrated on 2 s of stillness, so the robot holds still here -->
  <BehaviorTree ID="ekf_hold">
    <Sequence>
      <say text="Holding still to reset my balance estimate."/>
      <reset_ekf/>
    </Sequence>
  </BehaviorTree>

  <!-- Arm commands stay blocked after release_arms until the next mode change, and a transition to the current mode
       fails: so go to Idle first when in HighLevel, then HighLevel, then the VisualServo gains -->
  <BehaviorTree ID="prepare_arm">
    <Sequence>
      <Fallback>
        <Inverter>
          <in_high_level/>
        </Inverter>
        <set_mode mode="idle"/>
      </Fallback>
      <set_mode mode="high_level"/>
      <set_profile profile="visual_servo"/>
    </Sequence>
  </BehaviorTree>
</root>
