{
  "$comment": "The task session's deny rules, and the base of the discovery session's. A template: scripts/link_agent_dir.sh makes the settings from it. A guard against mistakes, not a security boundary: a wrapped command (bash -c, a Python script with rclpy) is not matched. showThinkingSummaries: the session log holds the reasoning, for the Mission feed. autoMemoryEnabled false: what the agent learns goes in the knowledge store, where it is graded; on 2026-11-20 Claude Code's own memory kept 'look before walking' outside it.",
  "showThinkingSummaries": true,
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Bash(ros2 topic pub:*)",
      "Bash(ros2 service call:*)",
      "Bash(ros2 action send_goal:*)",
      "Bash(ros2 param set:*)",
      "Bash(ros2 param load:*)",
      "Bash(ros2 param delete:*)",
      "Bash(ros2 lifecycle set:*)",
      "Bash(ros2 run:*)",
      "Bash(ros2 launch:*)",
      "Bash(ros2 bag play:*)",
      "Bash(ros2 component load:*)",
      "Bash(ros2 control:*)",
      "Bash(ros2 test:*)",
      "Bash(pytest:*)",
      "Bash(pytest-3:*)",
      "Bash(/usr/bin/pytest:*)",
      "Bash(py.test:*)",
      "Bash(py.test-3:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3.12 -m pytest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m launch_testing.launch_test:*)",
      "Bash(colcon test:*)",
      "Bash(launch_test:*)",
      "Bash(agent_cli step approve:*)",
      "Bash(agent_cli step refuse:*)",
      "Read(~/orchestrator_ws/**)",
      "Edit(~/orchestrator_ws/**)",
      "Edit(**/skill_registry/deny.yaml)",
      "Edit(**/runbook.md)",
      "Edit(**/claude_settings*.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.codex/rules/**)",
      "Edit(**/scripts/agent_settings.py)",
      "Edit(**/scripts/link_agent_dir.sh)"
    ]
  }
}
