<root BTCPP_format="4">
  <!-- Floor 1 only, with the robot already at the inside panel: hold for the EKF reset, press floor 1 with the right
       arm, press_judge, manipulation_recovery. -->
  <BehaviorTree ID="freight_elevator_floor1_press_agentic">
    <Sequence>
      <SubTree ID="ekf_hold"/>
      <no_stale_publishers/>
      <Fallback>
        <SubTree ID="press_floor1"/>
        <RetryUntilSuccessful num_attempts="3">
          <SubTree ID="recover_floor1"/>
        </RetryUntilSuccessful>
        <ForceFailure>
          <release_arms/>
        </ForceFailure>
        <say text="Please press floor one for me."/>
      </Fallback>
      <release_arms/>
      <set_mode mode="idle"/>
      <say text="Floor one is pressed."/>
    </Sequence>
  </BehaviorTree>

  <!-- the watcher keys on this exact text -->
  <BehaviorTree ID="ekf_hold">
    <Sequence>
      <say text="Holding still to reset my balance estimate."/>
      <Sleep msec="15000"/>
    </Sequence>
  </BehaviorTree>

  <!-- Arm commands stay blocked after release_arms until the next mode change, and a transition to the current mode
       fails: so go to Idle first when in HighLevel, then HighLevel, then the VisualServo gains -->
  <BehaviorTree ID="prepare_arm">
    <Sequence>
      <Fallback>
        <Inverter>
          <in_high_level/>
        </Inverter>
        <set_mode mode="idle"/>
      </Fallback>
      <set_mode mode="high_level"/>
      <set_profile profile="visual_servo"/>
    </Sequence>
  </BehaviorTree>



  <!-- inside: the right arm (E-007) -->
  <BehaviorTree ID="press_floor1">
    <Sequence>
      <set_press_offset x="0.005" y="0.0075" z="0.0034"/>   <!-- inside panel, right arm: lit floor 1 on 2026-11-04 (E-012) -->
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="floor 1" left_arm="false"/>
      <press_judge target_description="floor 1"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="recover_floor1">
    <Sequence>
      <manipulation_recovery phase="diagnose" target_description="floor 1" base_goal="{inside_freight_elevator_button_panel}"
                             decision="{decision}" goal="{recovery_goal}" left_arm="{recovery_left_arm}"
                             offset_x="{offset_x}" offset_y="{offset_y}" offset_z="{offset_z}"/>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="offset_retry"/>
        </Inverter>
        <set_press_offset x="{offset_x}" y="{offset_y}" z="{offset_z}"/>
      </Fallback>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="reposition"/>
        </Inverter>
        <Sequence>
          <release_arms/>
          <set_autonomy enabled="true"/>
          <navigate_to goal="{recovery_goal}"/>
          <set_autonomy enabled="false"/>
          <SubTree ID="ekf_hold"/>
          <manipulation_recovery phase="view_check" target_description="floor 1"/>
        </Sequence>
      </Fallback>
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="floor 1" left_arm="{recovery_left_arm}"/>
      <press_judge target_description="floor 1"/>
    </Sequence>
  </BehaviorTree>
</root>
