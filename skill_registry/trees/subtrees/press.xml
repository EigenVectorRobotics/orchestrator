<?xml version="1.0"?>
<root BTCPP_format="4">
    <BehaviorTree ID="press_panel_button">
        <Sequence>
            <Fallback>
                <Sequence>
                    <ForceSuccess>          <!-- the panel's base offset before the looks, so check_reach checks the goal this panel presses; a failure here leaves it to the press slot's own set_press_offset -->
                        <set_press_offset x="{press_base_offset_x}" y="{press_base_offset_y}" z="{press_base_offset_z}"/>
                    </ForceSuccess>
                    <SubTree ID="stance_check" name="stance_check"/>
                    <SubTree ID="press_and_recover"/>
                    <release_arms/>
                </Sequence>
                <Sequence>                  <!-- every failed slot asks for help, a lost button too (run 006 of 20261122T202416Z-64ce58) -->
                    <release_arms/>
                    <say text="{press_ask}"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="press_and_recover">
        <Sequence>
            <SetBlackboard output_key="pressed" value="no"/>
            <SetBlackboard output_key="press_tried" value="no"/>
            <SetBlackboard output_key="recovery_stop" value="no"/>
            <SetBlackboard output_key="press_offset_x" value="{press_base_offset_x}"/>
            <SetBlackboard output_key="press_offset_y" value="{press_base_offset_y}"/>
            <SetBlackboard output_key="press_offset_z" value="{press_base_offset_z}"/>
            <RetryUntilSuccessful num_attempts="4">
                <Fallback>
                    <Sequence>
                        <Fallback>          <!-- the first press goes at once; each later one after a diagnosis of the last, so the fourth failure gets none -->
                            <decision_is value="{press_tried}" equals="no"/>
                            <SubTree ID="recover_once"/>
                        </Fallback>
                        <SetBlackboard output_key="press_tried" value="yes"/>
                        <set_press_offset x="{press_offset_x}" y="{press_offset_y}" z="{press_offset_z}"/>
                        <reset_filters/>        <!-- no mode change or EKF reset: the look's reset holds from check_reach to the press -->
                        <press_button target_description="{button}" left_arm="{press_left_arm}"/>
                        <press_judge target_description="{button}"/>
                        <SetBlackboard output_key="pressed" value="yes"/>
                    </Sequence>
                    <decision_is value="{recovery_stop}" equals="yes"/>   <!-- the diagnosis stopped the presses: no more attempts -->
                </Fallback>
            </RetryUntilSuccessful>
            <decision_is value="{pressed}" equals="yes"/>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="recover_once">   <!-- success: press again; failure: stop pressing, with recovery_stop yes -->
        <Fallback>
            <Sequence>
                <manipulation_recovery phase="diagnose" target_description="{button}" base_goal="{press_panel}" decision="{decision}" goal="{recovery_goal}" left_arm="{press_left_arm}" offset_x="{press_offset_x}" offset_y="{press_offset_y}" offset_z="{press_offset_z}"/>
                <Fallback>
                    <Inverter>
                        <decision_is value="{decision}" equals="reposition"/>
                    </Inverter>
                    <Sequence>
                        <ForceSuccess>      <!-- the arms may be released already -->
                            <release_arms/>
                        </ForceSuccess>
                        <Fallback>
                            <RetryUntilSuccessful num_attempts="3">
                                <SubTree ID="look"/>
                            </RetryUntilSuccessful>
                            <Sequence>
                                <say text="I lost the button after moving."/>   <!-- then recovery_stop: no more presses, press_ask -->
                                <AlwaysFailure/>
                            </Sequence>
                        </Fallback>
                    </Sequence>
                </Fallback>
            </Sequence>
            <Sequence>
                <SetBlackboard output_key="recovery_stop" value="yes"/>
                <AlwaysFailure/>
            </Sequence>
        </Fallback>
    </BehaviorTree>
    <BehaviorTree ID="stance_check">
        <Sequence>
            <SetBlackboard output_key="recovery_goal" value="{press_panel}"/>
            <SetBlackboard output_key="stance_reset" value="no"/>
            <RetryUntilSuccessful num_attempts="10">
                <Fallback>
                    <SubTree ID="look"/>
                    <Sequence>
                        <manipulation_recovery phase="stance_check" target_description="{button}" base_goal="{press_panel}" decision="{decision}" goal="{recovery_goal}"/>
                        <decision_is value="{decision}" equals="continue"/>
                        <SubTree ID="look_here"/>   <!-- continue presses only after both checks pass from here; a failure counts as a failed look -->
                    </Sequence>
                </Fallback>
            </RetryUntilSuccessful>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="look">
        <Sequence>
            <SetBlackboard output_key="stance_reset" value="no"/>   <!-- a walk, even a failed one, needs a new EKF reset -->
            <set_autonomy enabled="true"/>
            <ForceSuccess>              <!-- asked before every walk, from where the robot stands now: a goal under WALK_MIN_M walks out first, so the walk onto it takes steps -->
                <Fallback>
                    <Inverter>
                        <near_pose goal="{recovery_goal}" approach="{recovery_approach}"/>
                    </Inverter>
                    <navigate_to goal="{recovery_approach}"/>
                </Fallback>
            </ForceSuccess>
            <navigate_to goal="{recovery_goal}"/>
            <set_autonomy enabled="false"/>
            <Sleep msec="2500"/>            <!-- the G1 settles up to 2.5 s after it stops: 6.5 cm and 11 deg on floor 2 -->
            <SubTree ID="look_here"/>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="look_here">
        <Sequence>
            <Fallback>                      <!-- one EKF reset per stance: mode and profile first, so it holds until the press -->
                <decision_is value="{stance_reset}" equals="yes"/>
                <Sequence>
                    <set_autonomy enabled="false"/>
                    <SubTree ID="prepare_arm"/>
                    <SubTree ID="ekf_hold"/>
                    <SetBlackboard output_key="stance_reset" value="yes"/>
                </Sequence>
            </Fallback>
            <reset_filters/>
            <button_in_view query="{button}" left_arm="{press_left_arm}"/>
            <check_reach left_arm="{press_left_arm}"/>   <!-- IK only, on the arm button_in_view chose: no arm motion when out of reach -->
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="ekf_hold">
        <Sequence>
            <say text="Holding still to reset my balance estimate."/>
            <reset_ekf/>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="prepare_arm">
        <Sequence>
            <Fallback>
                <Inverter>
                    <in_high_level/>
                </Inverter>
                <set_mode mode="idle"/>
            </Fallback>
            <set_mode mode="high_level"/>
            <set_profile profile="visual_servo"/>
        </Sequence>
    </BehaviorTree>
</root>