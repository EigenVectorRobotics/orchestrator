<root BTCPP_format="4">
  <!-- Ride the freight elevator from the cabin to another floor and walk out. The robot starts outside the cabin on
       current_floor with the door open (call the elevator first, e.g. freight_call_elevator_down_agentic).
       Edit the three SetBlackboard lines for the task: current_floor and target_floor are labels of the IMU floor
       counter (elevator_states imu_floor_detect_node, started with current_floor:=<the true floor>), and target_button
       is the button's name for GroundBoxes: "floor 1", "floor 2" or "floor 3".
       1. The counter must agree with current_floor, and the target must differ from it.
       2. Walk to the inside panel, EKF hold, stance check, press the target button (press_judge, manipulation_recovery),
          release the arms, Idle for the ride.
       3. Wait for the counter to read target_floor (up to 180 s): the label changes after each ride's deceleration, so a
          stop at another floor does not end the wait.
       4. HighLevel, then the door: the lidar first (door_open_lidar on the door place, up to 20 s); if it cannot tell,
          turn to face the door (a walk to the door view place) and ask the VLM (door_open, up to 20 s).
       5. Walk out to exit_goal.
       Places from ~/maps/two_floor_clean.places.yaml. Not saved yet, still to do: "freight elevator door" (the robot in
       the doorway, facing out; any floor), "inside freight elevator door view" (in the cabin, 0.25 m or more from the
       inside place, facing the door) and "exit goal" (the goal on the target floor, with that floor's z). -->
  <BehaviorTree ID="freight_elevator_ride_agentic">
    <Sequence>
      <!-- the task -->
      <SetBlackboard value="2" output_key="current_floor"/>
      <SetBlackboard value="1" output_key="target_floor"/>
      <SetBlackboard value="floor 1" output_key="target_button"/>

      <Fallback>
        <elevator_floor_is floor="{current_floor}"/>
        <ForceFailure>
          <say text="My floor counter does not agree with my start floor. Please restart it."/>
        </ForceFailure>
      </Fallback>
      <Fallback>
        <Inverter>
          <decision_is value="{current_floor}" equals="{target_floor}"/>
        </Inverter>
        <ForceFailure>
          <say text="I am already on that floor."/>
        </ForceFailure>
      </Fallback>

      <!-- in: walking state, the inside panel -->
      <Fallback>
        <in_high_level/>
        <set_mode mode="high_level"/>
      </Fallback>
      <clear_stop/>
      <set_autonomy enabled="true"/>
      <SubTree ID="walk_in"/>
      <set_autonomy enabled="false"/>

      <!-- press the target floor -->
      <SubTree ID="ekf_hold"/>
      <no_stale_publishers/>
      <SetBlackboard value="false" output_key="press_left_arm"/>
      <SubTree ID="stance_target"/>
      <Fallback>
        <SubTree ID="press_target"/>
        <RetryUntilSuccessful num_attempts="3">
          <SubTree ID="recover_target"/>
        </RetryUntilSuccessful>
        <ForceFailure>
          <release_arms/>
        </ForceFailure>
        <say text="Please press my floor for me."/>
      </Fallback>
      <release_arms/>
      <set_mode mode="idle"/>
      <say text="Floor pressed. Riding the elevator."/>

      <!-- ride: until the counter reads the target floor -->
      <Fallback>
        <Timeout msec="180000">
          <RetryUntilSuccessful num_attempts="-1">
            <Delay delay_msec="500">
              <elevator_floor_is floor="{target_floor}"/>
            </Delay>
          </RetryUntilSuccessful>
        </Timeout>
        <ForceFailure>
          <say text="I could not tell that we reached my floor. I am staying in the elevator."/>
        </ForceFailure>
      </Fallback>
      <say text="We are on my floor. Checking the door."/>

      <!-- out: walking state first, so the walk starts as soon as the door is seen open -->
      <set_mode mode="high_level"/>
      <clear_stop/>
      <SubTree ID="door_check"/>
      <say text="The door is open. Walking out."/>
      <set_autonomy enabled="true"/>
      <SubTree ID="walk_out"/>
      <set_autonomy enabled="false"/>
      <say text="I have arrived."/>
    </Sequence>
  </BehaviorTree>

  <!-- the lidar first; when it cannot tell in 20 s, face the door and ask the VLM -->
  <BehaviorTree ID="door_check">
    <Fallback>
      <Timeout msec="20000">
        <RetryUntilSuccessful num_attempts="-1">
          <Delay delay_msec="1000">
            <door_open_lidar door="{freight_elevator_door}"/>
          </Delay>
        </RetryUntilSuccessful>
      </Timeout>
      <Sequence>
        <say text="Turning to look at the door."/>
        <set_autonomy enabled="true"/>
        <navigate_to goal="{inside_freight_elevator_door_view}"/>
        <set_autonomy enabled="false"/>
        <RetryUntilSuccessful num_attempts="20">
          <Delay delay_msec="1000">
            <door_open/>
          </Delay>
        </RetryUntilSuccessful>
      </Sequence>
      <ForceFailure>
        <say text="The elevator door is closed."/>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <!-- a walk that finds no free path (latched terrain points): clear the terrain map and walk again -->
  <BehaviorTree ID="walk_in">
    <RetryUntilSuccessful num_attempts="3">
      <Fallback>
        <navigate_to goal="{inside_freight_elevator_button_panel}"/>
        <ForceFailure>
          <Sequence>
            <say text="My path looks blocked. Clearing my map and trying again."/>
            <clear_terrain_map/>
            <Sleep msec="2000"/>
          </Sequence>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <BehaviorTree ID="walk_out">
    <RetryUntilSuccessful num_attempts="3">
      <Fallback>
        <navigate_to goal="{exit_goal}"/>
        <ForceFailure>
          <Sequence>
            <say text="My path looks blocked. Clearing my map and trying again."/>
            <clear_terrain_map/>
            <Sleep msec="2000"/>
          </Sequence>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- the watcher keys on this exact text -->
  <BehaviorTree ID="ekf_hold">
    <Sequence>
      <say text="Holding still to reset my balance estimate."/>
      <Sleep msec="15000"/>
    </Sequence>
  </BehaviorTree>

  <!-- Arm commands stay blocked after release_arms until the next mode change, and a transition to the current mode
       fails: so go to Idle first when in HighLevel, then HighLevel, then the VisualServo gains -->
  <BehaviorTree ID="prepare_arm">
    <Sequence>
      <Fallback>
        <Inverter>
          <in_high_level/>
        </Inverter>
        <set_mode mode="idle"/>
      </Fallback>
      <set_mode mode="high_level"/>
      <set_profile profile="visual_servo"/>
    </Sequence>
  </BehaviorTree>

  <!-- before the first press: the inside panel's range (E-006); only a failed check calls the agent -->
  <BehaviorTree ID="stance_target">
    <Fallback>
      <Sequence>
        <track query="{target_button}"/>
        <Sleep msec="1000"/>                   <!-- the first box and 3D pose after the seed -->
        <button_in_view/>
        <button_in_reach min_ahead_m="0.38" max_ahead_m="0.46"/>
      </Sequence>
      <Sequence>
        <manipulation_recovery phase="stance_check" target_description="{target_button}" base_goal="{inside_freight_elevator_button_panel}"
                               decision="{decision}" goal="{recovery_goal}" left_arm="{press_left_arm}"/>
        <Fallback>
          <Inverter>
            <decision_is value="{decision}" equals="reposition"/>
          </Inverter>
          <Sequence>
            <set_autonomy enabled="true"/>
            <navigate_to goal="{recovery_goal}"/>
            <set_autonomy enabled="false"/>
            <SubTree ID="ekf_hold"/>
            <manipulation_recovery phase="view_check" target_description="{target_button}"/>
          </Sequence>
        </Fallback>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <!-- inside: the right arm (E-007); the offset lit floor 1 on 2026-11-04 (E-012), not yet tried on other floors -->
  <BehaviorTree ID="press_target">
    <Sequence>
      <set_press_offset x="0.005" y="0.0075" z="0.0034"/>
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="{target_button}" left_arm="{press_left_arm}"/>
      <press_judge target_description="{target_button}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="recover_target">
    <Sequence>
      <manipulation_recovery phase="diagnose" target_description="{target_button}" base_goal="{inside_freight_elevator_button_panel}"
                             decision="{decision}" goal="{recovery_goal}" left_arm="{recovery_left_arm}"
                             offset_x="{offset_x}" offset_y="{offset_y}" offset_z="{offset_z}"/>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="offset_retry"/>
        </Inverter>
        <set_press_offset x="{offset_x}" y="{offset_y}" z="{offset_z}"/>
      </Fallback>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="reposition"/>
        </Inverter>
        <Sequence>
          <release_arms/>
          <set_autonomy enabled="true"/>
          <navigate_to goal="{recovery_goal}"/>
          <set_autonomy enabled="false"/>
          <SubTree ID="ekf_hold"/>
          <manipulation_recovery phase="view_check" target_description="{target_button}"/>
        </Sequence>
      </Fallback>
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="{target_button}" left_arm="{recovery_left_arm}"/>
      <press_judge target_description="{target_button}"/>
    </Sequence>
  </BehaviorTree>
</root>
