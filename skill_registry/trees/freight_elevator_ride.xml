<root BTCPP_format="4">
  <!-- EXAMPLE tree: one ride by the freight elevator, with door preemption both ways. Distilled from the test trees
       freight_elevator_down_floor1_door_preempt and freight_elevator_up_floor2_door_preempt (run 20261108T005956Z-6ad1b1);
       only the parameters differ between rides.
       1. Walk to the call panel and press the call button (the operator may press it too). door_open (lidar) is checked
          on every tick: once the door opens, the walk or the press is halted, the arms are released and, 1 s later,
          the robot walks to {inside_panel}.
       2. In the cabin: EKF hold and press the floor button. Checked on every tick: inside_cabin, at_floor {floor} and
          door_open. Once all three hold, the arms are released; LIO leaves elevator mode (z snaps to the floor) and the
          robot walks out on its own estimate to {door_out}, relocalizes there and walks on to {target}.
       Each press (press_panel_button, from freight_elevator_down_floor1_agentic, tested 2026-11-04 to 11-06): EKF hold
       (10 s), a stance check before the first press (track, button_in_view, button_in_reach; manipulation_recovery
       phase stance_check only when one fails), press_button and press_judge, manipulation_recovery up to three times,
       then a person is asked. Needs the Thor's grounding: with ~/fake_button_pose.py there is no 2D box, so
       button_in_view always fails and button_in_reach checks a fixed pose.
       To change the ride, change the parameters only (the planner overrides them with <use_tree id="freight_elevator_ride" .../>). To change how a button is pressed, replace the SubTree
       press_panel_button: it reads button, press_panel, press_left_arm, press_offset_x/y/z, reach_min, reach_max and
       press_ask, and writes press_left_arm (a switch_arm before the first press).
       Parameters for floor 2 to floor 1. Floor 1 to floor 2: call_panel_preapproach and call_panel
       {freight_elevator_call_panel_floor_1}, call_button "up button", floor_button "floor 2", floor 2,
       door_out {freight_elevator_door_out_floor_2}, target {target_floor_2}.
       Places: ~/maps/two_floor_clean_cabin2.places.yaml (map two_floor_clean_cabin2.pcd). Needs navigation_stack
       jean/elevator-side and elevator_states jean/door-state-in-out. -->
  <BehaviorTree ID="freight_elevator_ride">
    <Sequence>
      <Sequence name="parameters">   <!-- the planner can override these: <use_tree id="..." floor="2"/> -->
        <SetBlackboard value="{freight_elevator_call_panel_preapproach}" output_key="call_panel_preapproach"/>
        <SetBlackboard value="{freight_elevator_call_panel}" output_key="call_panel"/>
        <SetBlackboard value="down button" output_key="call_button"/>
        <SetBlackboard value="{inside_freight_elevator_button_panel}" output_key="inside_panel"/>
        <SetBlackboard value="floor 1" output_key="floor_button"/>
        <SetBlackboard value="1" output_key="floor"/>
        <SetBlackboard value="{freight_elevator_door_out_floor_1}" output_key="door_out"/>
        <SetBlackboard value="{target_floor_1}" output_key="target"/>
      </Sequence>

      <SetBlackboard value="no" output_key="exiting"/>
      <Fallback>
        <!-- the SLAM guard: outside the cabin, an unhealthy SLAM (a LIO divergence, lost tracking) halts the task at once;
             in the cabin it is let through (no matching on a ride); exiting: from the door open at the target floor
             until the relocalization out of the door -->
        <ReactiveSequence>
          <Fallback>
            <slam_healthy/>
            <inside_cabin/>
            <decision_is value="{exiting}" equals="yes"/>
          </Fallback>
          <Sequence>
            <Fallback>                    <!-- a transition to the current mode fails -->
              <in_high_level/>
              <set_mode mode="high_level"/>
            </Fallback>
            <clear_stop/>
            <ReactiveFallback>
              <door_open/>
              <SubTree ID="call_and_wait"/>
            </ReactiveFallback>
            <say text="The door is open. Walking into the elevator."/>
            <Parallel success_count="2" failure_count="1">
              <ForceSuccess>              <!-- the arms may be released already -->
                <release_arms/>
              </ForceSuccess>
              <Delay delay_msec="1000">   <!-- start the walk 1 s after the release starts -->
                <SubTree ID="walk_in"/>
              </Delay>
            </Parallel>
            <set_autonomy enabled="false"/>
            <ReactiveFallback>
              <Sequence>
                <inside_cabin/>
                <at_floor floor="{floor}"/>
                <door_open/>
              </Sequence>
              <SubTree ID="press_and_ride"/>
            </ReactiveFallback>
            <SetBlackboard value="yes" output_key="exiting"/>
            <say text="I am at my floor and the door is open. Walking out."/>
            <Parallel success_count="2" failure_count="1">
              <ForceSuccess>              <!-- the arms first, at once -->
                <release_arms/>
              </ForceSuccess>
              <Sequence>                  <!-- the walk once z is on the floor -->
                <RetryUntilSuccessful num_attempts="20">   <!-- slam_elevatorlio ends LIO's elevator mode at the open door -->
                  <Delay delay_msec="500">
                    <Inverter>
                      <in_elevator/>
                    </Inverter>
                  </Delay>
                </RetryUntilSuccessful>
                <Sleep msec="1500"/>      <!-- the snap resets localized; ~/status comes once a second -->
                <Fallback>
                  <RetryUntilSuccessful num_attempts="20">
                    <Delay delay_msec="500">
                      <localized/>
                    </Delay>
                  </RetryUntilSuccessful>
                  <ForceFailure>
                    <say text="I could not relocalize after the ride."/>
                  </ForceFailure>
                </Fallback>
                <SubTree ID="walk_out"/>
              </Sequence>
            </Parallel>
            <set_autonomy enabled="false"/>
            <say text="I have arrived."/>
          </Sequence>
        </ReactiveSequence>
        <ForceFailure>
          <Sequence>
            <Inverter>
              <Fallback>
                <slam_healthy/>
                <inside_cabin/>
                <decision_is value="{exiting}" equals="yes"/>
              </Fallback>
            </Inverter>
            <say text="My localization failed. Please relocalize me."/>
          </Sequence>
        </ForceFailure>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- walk to the panel, press the call button, wait for the door. Halted when the door opens; fails when the door stays closed -->
  <BehaviorTree ID="call_and_wait">
    <Sequence>
      <set_autonomy enabled="true"/>
      <navigate_to goal="{call_panel_preapproach}"/>
      <Sleep msec="3000"/>
      <navigate_to goal="{call_panel}"/>
      <set_autonomy enabled="false"/>
      <SubTree ID="ekf_hold"/>
      <SetBlackboard value="{call_button}" output_key="button"/>
      <SetBlackboard value="{call_panel}" output_key="press_panel"/>
      <SetBlackboard value="false" output_key="press_left_arm"/>
      <SetBlackboard value="0.0" output_key="press_offset_x"/>
      <SetBlackboard value="0.0" output_key="press_offset_y"/>
      <SetBlackboard value="0.0" output_key="press_offset_z"/>
      <SetBlackboard value="0.33" output_key="reach_min"/>   <!-- call panel: the stances that worked (E-006) -->
      <SetBlackboard value="0.48" output_key="reach_max"/>
      <SetBlackboard value="Please press the call button for me." output_key="press_ask"/>
      <SubTree ID="press_panel_button"/>
      <say text="Waiting for the elevator door."/>
      <Sleep msec="60000"/>
      <say text="The elevator door did not open within one minute."/>
      <AlwaysFailure/>
    </Sequence>
  </BehaviorTree>

  <!-- in the cabin: press the floor button, wait for the ride. Halted at the floor with the door open; fails after three minutes -->
  <BehaviorTree ID="press_and_ride">
    <!-- slam_elevatorlio starts LIO's elevator mode when the door closes with the robot in the cabin -->
    <Sequence>
      <SubTree ID="ekf_hold"/>
      <SetBlackboard value="{floor_button}" output_key="button"/>
      <SetBlackboard value="{inside_panel}" output_key="press_panel"/>
      <SetBlackboard value="false" output_key="press_left_arm"/>   <!-- inside: the right arm (E-007) -->
      <SetBlackboard value="0.005" output_key="press_offset_x"/>   <!-- inside panel, right arm: lit floor 1 on 2026-11-04 (E-012) -->
      <SetBlackboard value="0.0075" output_key="press_offset_y"/>
      <SetBlackboard value="0.0034" output_key="press_offset_z"/>
      <SetBlackboard value="0.38" output_key="reach_min"/>   <!-- inside panel: the stances that worked (E-006) -->
      <SetBlackboard value="0.46" output_key="reach_max"/>
      <SetBlackboard value="Please press my floor button for me." output_key="press_ask"/>
      <SubTree ID="press_panel_button"/>
      <say text="Waiting for my floor."/>
      <Sleep msec="180000"/>
      <say text="I did not reach my floor within three minutes."/>
      <AlwaysFailure/>
    </Sequence>
  </BehaviorTree>

  <!-- the press slot: check the stance, press {button} at {press_panel} and judge the press, recover up to three times,
       else ask a person; the arms end released. press_judge must come right after press_button: a not_pressed is
       recorded as the failed check of that press, which manipulation_recovery reads (get_failure, checked_call).
       Replace this SubTree to change how a button is pressed -->
  <BehaviorTree ID="press_panel_button">
    <Sequence>
      <no_stale_publishers/>
      <SubTree ID="stance_check"/>
      <Fallback>
        <Sequence>
          <set_press_offset x="{press_offset_x}" y="{press_offset_y}" z="{press_offset_z}"/>
          <SubTree ID="prepare_arm"/>
          <reset_filters/>
          <press_button target_description="{button}" left_arm="{press_left_arm}"/>
          <press_judge target_description="{button}"/>
        </Sequence>
        <RetryUntilSuccessful num_attempts="3">
          <SubTree ID="recover_press"/>
        </RetryUntilSuccessful>
        <ForceFailure>
          <release_arms/>
        </ForceFailure>
        <say text="{press_ask}"/>
      </Fallback>
      <release_arms/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="recover_press">
    <Sequence>
      <manipulation_recovery phase="diagnose" target_description="{button}" base_goal="{press_panel}"
                             decision="{decision}" goal="{recovery_goal}" left_arm="{recovery_left_arm}"
                             offset_x="{offset_x}" offset_y="{offset_y}" offset_z="{offset_z}"/>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="offset_retry"/>
        </Inverter>
        <set_press_offset x="{offset_x}" y="{offset_y}" z="{offset_z}"/>
      </Fallback>
      <Fallback>
        <Inverter>
          <decision_is value="{decision}" equals="reposition"/>
        </Inverter>
        <Sequence>
          <release_arms/>
          <set_autonomy enabled="true"/>
          <navigate_to goal="{recovery_goal}"/>
          <set_autonomy enabled="false"/>
          <SubTree ID="ekf_hold"/>
          <manipulation_recovery phase="view_check" target_description="{button}"/>
        </Sequence>
      </Fallback>
      <SubTree ID="prepare_arm"/>
      <reset_filters/>
      <press_button target_description="{button}" left_arm="{recovery_left_arm}"/>
      <press_judge target_description="{button}"/>
    </Sequence>
  </BehaviorTree>

  <!-- before the first press: a fresh track, then the button in view and in reach (E-006, {reach_min} to {reach_max} m
       ahead). A failed check goes to the agent (phase stance_check), which may move the robot or switch the arm first:
       a poor stance comes from the walk, not from the press (E-001, E-015). Without an agent, or when its walk fails,
       the press goes ahead and a failure goes to recover_press -->
  <BehaviorTree ID="stance_check">
    <Fallback>
      <Sequence>
        <track query="{button}"/>
        <Sleep msec="1000"/>                   <!-- the first box and 3D pose after the seed -->
        <button_in_view/>
        <button_in_reach min_ahead_m="{reach_min}" max_ahead_m="{reach_max}"/>
      </Sequence>
      <Sequence>
        <manipulation_recovery phase="stance_check" target_description="{button}" base_goal="{press_panel}"
                               decision="{decision}" goal="{recovery_goal}" left_arm="{stance_left_arm}"/>
        <Fallback>                            <!-- the arm changes on switch_arm only: on any other decision the agent's
                                                   left_arm is not the arm in use (a failed check has none) -->
          <Inverter>
            <decision_is value="{decision}" equals="switch_arm"/>
          </Inverter>
          <SetBlackboard value="{stance_left_arm}" output_key="press_left_arm"/>
        </Fallback>
        <Fallback>
          <Inverter>
            <decision_is value="{decision}" equals="reposition"/>
          </Inverter>
          <Sequence>
            <set_autonomy enabled="true"/>
            <navigate_to goal="{recovery_goal}"/>
            <set_autonomy enabled="false"/>
            <SubTree ID="ekf_hold"/>
            <manipulation_recovery phase="view_check" target_description="{button}"/>
          </Sequence>
        </Fallback>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <!-- the watcher keys on this exact text -->
  <BehaviorTree ID="ekf_hold">
    <Sequence>
      <say text="Holding still to reset my balance estimate."/>
      <Sleep msec="10000"/>   <!-- ekf_reset.sh: stop + 3 s + relaunch (about 4 s), calibration 2 s, 4 s margin -->
    </Sequence>
  </BehaviorTree>

  <!-- Arm commands stay blocked after release_arms until the next mode change, and a transition to the current mode
       fails: so go to Idle first when in HighLevel, then HighLevel, then the VisualServo gains -->
  <BehaviorTree ID="prepare_arm">
    <Sequence>
      <Fallback>
        <Inverter>
          <in_high_level/>
        </Inverter>
        <set_mode mode="idle"/>
      </Fallback>
      <set_mode mode="high_level"/>
      <set_profile profile="visual_servo"/>
    </Sequence>
  </BehaviorTree>

  <!-- a walk that finds no free path (latched terrain points): clear the terrain map and walk again -->
  <BehaviorTree ID="walk_in">
    <Sequence>
      <set_autonomy enabled="true"/>
      <RetryUntilSuccessful num_attempts="3">
        <Fallback>
          <navigate_to goal="{inside_panel}"/>
          <ForceFailure>
            <Sequence>
              <say text="My path looks blocked. Clearing my map and trying again."/>
              <clear_terrain_map/>
              <Sleep msec="2000"/>
            </Sequence>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <!-- out of the cabin: stop 1 m out of the door and relocalize in place (the cabin matches poorly), then walk on.
       A walk that finds no free path (latched terrain points): clear the terrain map and walk again -->
  <BehaviorTree ID="walk_out">
    <Sequence>
      <set_autonomy enabled="true"/>
      <navigate_to goal="{door_out}"/>
      <Sleep msec="1000"/>
      <say text="Stopping to relocalize."/>
      <relocalize_here/>
      <SetBlackboard value="no" output_key="exiting"/>
      <RetryUntilSuccessful num_attempts="3">
        <Fallback>
          <navigate_to goal="{target}"/>
          <ForceFailure>
            <Sequence>
              <say text="My path looks blocked. Clearing my map and trying again."/>
              <clear_terrain_map/>
              <Sleep msec="2000"/>
            </Sequence>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>
</root>
