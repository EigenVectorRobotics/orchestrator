<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_skills</name>
  <version>0.0.0</version>
  <description>The G1's skills for the orchestrator: one folder per skill with its contract, code, agent prompts and notes</description>
  <maintainer email="karankha@andrew.cmu.edu">Karan Khanna</maintainer>
  <license>MIT</license>

  <exec_depend>orchestrator</exec_depend>
  <exec_depend>skill_registry</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>         <!-- press_button capture -->
  <exec_depend>python3-pil</exec_depend>           <!-- press_button crops -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
